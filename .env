#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# Atur ke 'development' untuk mode debug, atau 'production' saat rilis ke server live
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# Sesuaikan base URL dengan alamat lokal atau domain Anda
app.baseURL = 'http://localhost:8080/'

# Jika menggunakan index.php di URL, ubah ke 'index.php'
app.indexPage = ''

# Protokol dan keamanan
# app.forceGlobalSecureRequests = false

# Waktu zona (Timezone Indonesia)
app.appTimezone = 'Asia/Jakarta'

# Karakter encoding
app.appCharset = 'UTF-8'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = patients_dvh
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION / SESSION
#--------------------------------------------------------------------

# Kunci enkripsi aplikasi (bisa diganti dengan string acak minimal 32 karakter)
security.encryptionKey = 'your-random-secure-encryption-key-here'

# Konfigurasi Session
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = null
session.matchIP = false
session.timeToUpdate = 300
session.regenerateDestroy = false

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# Threshold log: 1 = Emergency, 2 = Alert, 3 = Critical, 4 = Error, 5 = Warning, 6 = Notice, 7 = Info, 8 = Debug
logger.threshold = 4

#--------------------------------------------------------------------
# CUSTOM CONFIG (Optional untuk Python Bridge & DICOM Paths)
#--------------------------------------------------------------------

# Path opsional jika executable python di server Anda berada di direktori khusus
# python.executablePath = 'python'